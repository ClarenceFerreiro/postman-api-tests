{
  "info": {
    "_postman_id": "67345ba9-63bc-4503-a467-24d4e1c30ce8",
    "name": "My Collection",
    "description": "Мои автотесты для API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "POST Создать пост",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const response = pm.response.json();\r",
              "\r",
              "pm.test(\"Статус 200 OK\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "pm.test(\"Ответ содержит наши данные\", function () {\r",
              "    pm.expect(response.json.title).to.eql(\"Мой первый автотест\");\r",
              "});\r",
              "\r",
              "pm.test(\"Тело ответа не пустое\", function () {\r",
              "    pm.expect(response.json).to.not.be.undefined;\r",
              "});\r",
              "\r",
              "pm.test(\"Content-Type = JSON\", function () {\r",
              "    pm.response.to.have.header(\"Content-Type\");\r",
              "    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\");\r",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\r\n    \"title\": \"Мой первый автотест\",\r\n    \"body\": \"Этот пост создан из Postman\",\r\n    \"userId\": 1\r\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "https://postman-echo.com/post",
          "protocol": "https",
          "host": ["postman-echo", "com"],
          "path": ["post"]
        }
      },
      "response": []
    },
    {
      "name": "GET Получить пост",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const data = pm.response.json();",
              "",
              "pm.test(\"Status 200\", () => {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"ID = 1\", () => {",
              "    pm.expect(data.id).to.equal(1);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": {
          "raw": "https://jsonplaceholder.typicode.com/posts/1",
          "protocol": "https",
          "host": ["jsonplaceholder", "typicode", "com"],
          "path": ["posts", "1"]
        }
      },
      "response": []
    }
  ]
}
