  "item": [
    {
      "name": "POST Создать пост",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "// Получаем ответ от сервера\r",
              "const response = pm.response.json();\r",
              "\r",
              "// Тесты\r",
              "pm.test(\"Статус 200 OK\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "pm.test(\"Ответ содержит наши данные\", function () {\r",
              "    pm.expect(response.json.title).to.eql(\"Мой первый автотест\");\r",
              "});\r",
              "\r",
              "pm.test(\"Тело ответа не пустое\", function () {\r",
              "    pm.expect(response.json).to.not.be.undefined;\r",
              "});\r",
              "\r",
              "// Выводим в консоль для отладки\r",
              "console.log(\"Ответ сервера:\", response);\r",
              "\r",
              "pm.test(\"Content-Type = JSON\", function () {\r",
              "    pm.response.to.have.header(\"Content-Type\");\r",
              "    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\");\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\r\n    \"title\": \"Мой первый автотест\",\r\n    \"body\": \"Этот пост создан из Postman\",\r\n    \"userId\": 1\r\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "https://postman-echo.com/post",
          "protocol": "https",
          "host": [
            "postman-echo",
            "com"
          ],
          "path": [
            "post"
          ]
        }
      },
      "response": []
    },
    {
      "name": "GET Получить пост",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const data = pm.response.json();\r",
              "\r",
              "pm.test(\"Статус 200\", () => {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "pm.test(\"ID = 1\", () => {\r",
              "    pm.expect(data.id).to.equal(1);\r",
              "});\r",
              "\r",
              "pm.test(\"Есть заголовок\", () => {\r",
              "    pm.expect(data.title).to.be.a('string');\r",
              "});\r",
              "\r",
              "// НОВЫЙ ТЕСТ\r",
              "pm.test(\"userId — число\", function () {\r",
              "    pm.expect(data.userId).to.be.a('number');\r",
              "});\r",
              "\r",
              "// Проверка по Заданию 2\r",
              "pm.test(\"Проверка userId\", function () {\r",
              "    pm.expect(data.userId).to.be.a('number');\r",
              "    pm.expect(data.userId).to.equal(1);  // и число, и равно 1\r",
              "    pm.expect(data.userId).to.be.above(0); // и больше нуля\r",
              "});\r",
              "\r",
              "// проверка \"не пустое тело\"\r",
              "pm.test(\"Тело ответа не пустое\", function () {\r",
              "    const data = pm.response.json();\r",
              "    pm.expect(data).to.not.be.empty;\r",
              "});\r",
              "\r",
              "// Проверка заголовка Content-Type\r",
              "pm.test(\"Content-Type = application/json\", function () {\r",
              "    pm.response.to.have.header(\"Content-Type\");\r",
              "    const contentType = pm.response.headers.get(\"Content-Type\");\r",
              "    pm.expect(contentType).to.include(\"application/json\");\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "protocolProfileBehavior": {
        "disableBodyPruning": true
      },
