# Base URL
# For production testing: https://jsonplaceholder.typicode.com
# For local testing: http://localhost:3000
BASE_URL=https://jsonplaceholder.typicode.com

# Test Environment
# 'mock' — Docker json-server (localhost:3000)
# 'integration' — real test environment
TEST_ENV=integration

# Request Settings
REQUEST_TIMEOUT_MS=5000
RETRY_ATTEMPTS=3
MAX_CONTENT_LENGTH=1048576

# Performance Thresholds (ms)
PERF_CRITICAL_MS=200
PERF_WARNING_MS=500
PERF_FAILURE_MS=1000
