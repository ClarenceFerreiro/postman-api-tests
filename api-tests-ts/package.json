{
  "name": "postman-api-tests-ts",
  "version": "2.0.0",
  "description": "TypeScript API automation tests with Supertest, Jest, AJV",
  "scripts": {
    "test": "jest",
    "test:smoke": "jest --testNamePattern='Smoke'",
    "test:negative": "jest --testNamePattern='Negative'",
    "test:regression": "jest --testNamePattern='Regression'",
    "test:performance": "jest --testNamePattern='Performance'",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --ci --reporters=default --reporters=jest-junit",
    "test:allure": "jest --reporters=default --reporters=allure",
    "lint": "eslint src/**/*.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.13.10",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^8.26.1",
    "@typescript-eslint/parser": "^8.26.1",
    "eslint": "^9.22.0",
    "jest": "^29.7.0",
    "jest-junit": "^16.0.0",
    "allure-jest": "^3.9.0",
    "allure-js-commons": "^3.9.0",
    "ts-jest": "^29.2.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.2"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "dotenv": "^16.4.7",
    "supertest": "^7.0.0"
  }
}
