  "item": [
    {
      "name": "/api/login",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const response = pm.response.json();\r",
              "\r",
              "pm.test(\"Статус 200 OK\", () => {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "pm.test(\"Логин передан верно\", () => {\r",
              "    pm.expect(response.json.username).to.equal(\"testuser\");\r",
              "});\r",
              "\r",
              "// Создаём фейковый токен (в реальном API он бы пришёл с сервера)\r",
              "pm.collectionVariables.set(\"authToken\", \"fake-jwt-token-456\");\r",
              "console.log(\"Token saved:\", pm.collectionVariables.get(\"authToken\"));"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\"username\": \"testuser\", \"password\": \"secret\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "https://postman-echo.com/post",
          "protocol": "https",
          "host": [
            "postman-echo",
            "com"
          ],
          "path": [
            "post"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Get User with Token",
      "request": {
        "method": "GET",
        "header": []
      },
      "response": []
    }
  ],
